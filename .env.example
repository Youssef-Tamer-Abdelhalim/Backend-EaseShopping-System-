PORT=8000
# this changes to 'production' when deploying
NODE_ENV=development

BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# database
DB_URI=

# CORS Configuration
# Development: Local Next.js server
# Production: Your production domain only
CORS_ORIGINS=

# JWT
JWT_SECRET_KEY=
JWT_EXPIRE_TIME=90d

# Refresh Token (separate secret, longer expiry)
JWT_REFRESH_SECRET_KEY=
JWT_REFRESH_EXPIRE_TIME=7d

# email (SMTP)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=email@example.com
EMAIL_PASS="your_email_password_from_smtp_provider(brevo, gmail, etc.)"

# Payment Gateway
## Stripe
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=


# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=